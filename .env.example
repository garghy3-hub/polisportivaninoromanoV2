# Public Supabase connection values used by Vite at build time.
# Use the project URL and publishable key from Supabase > Connect.
# These values are not secrets. Never put a service_role or secret key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
